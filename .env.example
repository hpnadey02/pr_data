# Template - copy to .env and fill in real values.

# ======================= DATA SOURCE SWITCH =======================
# Exactly ONE backend is ever initialised.
#   sqlserver -> enterprise SSMS over ODBC (needs DB_* below + ODBC Driver 17)
#   local     -> the .csv or .xlsx at LOCAL_DATA_PATH, queried with DuckDB (no ODBC)
# Change this one line and restart the backend to switch.
DATA_SOURCE=sqlserver
LOCAL_DATA_PATH=D:/path/to/your_data.csv
# Only used for .xlsx sources. Ignored for .csv.
LOCAL_SHEET_NAME=

# ======================= LLM PROVIDER SWITCH ======================
# Exactly ONE provider is ever initialised.
#   ollama -> fully local/on-prem, nothing leaves this machine
#   gemini -> Google Gemini API; needs GEMINI_API_KEY below. Your question AND the
#             figures computed from your data are sent to Google.
# Change this one line and restart the backend to switch.
# NOTE: after switching, re-run `python scripts/setup_chromadb.py` once - the semantic
# index is stored per provider because the two embedding spaces are not interchangeable.
LLM_PROVIDER=ollama

# ======================= CHART TYPE SWITCH ========================
# Which chart(s) appear beside every insight.
#   auto          -> chosen per question: donut for a share/contribution question with
#                    up to 8 slices, bar for everything else
#   bar           -> always a bar chart
#   pie           -> always a pie chart
#   donut         -> always a donut chart
#   bar,pie,donut -> one chart of EACH listed type, in that order (any mix: bar,donut)
#   all           -> same as bar,pie,donut
# A chart type named in the question ("... as a pie chart") still wins over this line.
# A pie/donut is drawn as a bar when it cannot show the data honestly (a time axis, or
# negative values) - the Warnings panel says so. Change this line and restart the backend.
CHART_TYPE=auto

# ======================= LOGIN SWITCH =============================
# How people sign in.
#   csv -> the email form; an email listed in USERS_CSV (data/users.csv) gets in.
#   sso -> no form; nginx + oauth2-proxy sign the user in with the company identity
#          provider (deploy/sso/nginx_sso.conf). The email form is switched off.
# Either way the developer role comes only from the role column of USERS_CSV.
# Change this line and restart BOTH the backend and the frontend.
AUTH_MODE=csv
# Needed only for sso, at least 16 characters; frontend and backend read the same value.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SSO_SHARED_SECRET=
# sso only. false = anyone the SSO lets in may use the chatbot (as a user unless USERS_CSV
# says developer). true = they must also be listed in USERS_CSV.
SSO_REQUIRE_USERS_CSV=false

# ---------------- Microsoft Entra ID (sso only) ----------------
# From the Entra app registration. Used by oauth2-proxy, not the app itself: after filling
# or changing these, run  python scripts\build_oauth2_proxy_config.py
# Directory (tenant) ID - GUID from the app registration's Overview page
ENTRA_TENANT_ID=
# Application (client) ID - GUID from the same page
ENTRA_CLIENT_ID=
# The secret's VALUE (Certificates & secrets), not its Secret ID
ENTRA_CLIENT_SECRET=
# https://<chatbot-host>/oauth2/callback - registered in Entra under Authentication, exactly
ENTRA_REDIRECT_URI=
# oauth2-proxy's cookie key:  python -c "import secrets; print(secrets.token_hex(16))"
SSO_COOKIE_SECRET=
# Comma list of email domains allowed in; * = anyone in the tenant
SSO_EMAIL_DOMAINS=*

# ---------------- Gemini (used only when LLM_PROVIDER=gemini) ----------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_SQL_MODEL=gemini-2.0-flash
GEMINI_INSIGHT_MODEL=gemini-2.0-flash
GEMINI_ROUTER_MODEL=gemini-2.0-flash-lite
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_REQUEST_TIMEOUT=120
GEMINI_CONNECT_TIMEOUT=5
GEMINI_RETRY_COUNT=1
GEMINI_MAX_OUTPUT_TOKENS=800
# -1 = omit thinkingConfig (correct for 2.0 models). Set 0 if you switch to a 2.5 model,
# otherwise reasoning tokens consume the output budget and answers come back empty.
GEMINI_THINKING_BUDGET=-1

# ---------------- SQL Server (used only when DATA_SOURCE=sqlserver) ----------------
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=10.0.0.1
DB_DATABASE=YOUR_DB
DB_TABLE=dbo.May_2
DB_USERNAME=your-username
DB_PASSWORD=your-password-here
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=30
DB_MAX_ROWS=5000

# ---------------- Ollama (local LLM runtime) ----------------
# MODEL CHOICE IS SIZED FOR THIS HOST: 15.6 GB RAM, no discrete GPU (CPU inference).
# Running two different 7B models keeps ~9.4 GB resident and was the underlying cause of
# the request timeouts (and of a native onnxruntime load failure under memory pressure).
# SQL and insight therefore share ONE 7B model (~4.7 GB resident), which is safe here
# because insight figures are now taken from the query result and verified rather than
# re-typed by the model. A 3B model handles cheap follow-up rewrites.
#
# If you move this to a GPU box with >=24 GB, set OLLAMA_INSIGHT_MODEL=qwen2.5:7b for
# slightly better prose.
OLLAMA_HOST=http://localhost:11434
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
OLLAMA_INSIGHT_MODEL=qwen2.5-coder:7b
OLLAMA_ROUTER_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_RETRY_COUNT=1
# Keeps weights resident between questions - removes the cold-load that was timing out.
OLLAMA_KEEP_ALIVE=30m
# 4096 is ample for a 24-column prompt and materially faster than 8192 on CPU.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=600
OLLAMA_WARMUP_ON_STARTUP=true

# Numbers must never vary. Only free prose is allowed any sampling temperature.
LLM_SQL_TEMPERATURE=0.0
LLM_NUMERIC_TEMPERATURE=0.0
LLM_TEXT_TEMPERATURE=0.2

# ---------------- ChromaDB (local semantic retrieval) ----------------
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_SCHEMA_COLLECTION=schema_metadata
CHROMA_EXAMPLES_COLLECTION=example_queries
CHROMA_TOP_K=8
CHROMA_TELEMETRY=false

# ---------------- Column shortcut dictionary ----------------
COLUMN_ALIASES_FILE=./backend/knowledge/column_aliases.json
COLUMN_FUZZY_THRESHOLD=0.86

# ---------------- Cache ----------------
CACHE_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=21600

# ---------------- Backend (FastAPI / Uvicorn) ----------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
REQUEST_TIMEOUT_SECONDS=600
SESSION_TIMEOUT_MINUTES=480
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8501

# ---------------- Frontend (Streamlit) ----------------
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_REQUEST_TIMEOUT_SECONDS=620

# ---------------- Data files ----------------
USERS_CSV=./data/users.csv
# Chat audit log - one folder per calendar month, each holding
#   chat_logs_YYYY-MM_week1.csv (days 1-7)   ..._week2.csv (8-14)   ..._week3.csv (15-21)
#   chat_logs_YYYY-MM_week4.csv (22-end)     chat_logs_YYYY-MM_month.csv (whole month)
# Every question goes into its week file AND its month file (by this machine's date).
CHAT_LOGS_DIR=./data/chat_logs
# Calendar months kept, INCLUDING the current one. 2 = this month + last month; older month
# folders are deleted automatically (at backend start and once a day). Must be 1 or more.
CHAT_LOG_KEEP_MONTHS=2
# The old single-file log. No longer written; import it once with
#   python scripts\init_data_files.py --split-legacy
CHAT_LOGS_CSV=./data/chat_logs.csv
SESSIONS_FILE=./data/sessions.json
SCHEMA_METADATA_FILE=./data/schema_metadata.json

# ---------------- Logging ----------------
LOG_DIR=./logs
LOG_LEVEL=INFO
